# KRE8ECH Website Environment Configuration
# Copy this file to .env.local for local development or configure GitHub Actions Variables

# Google Apps Script Web App URL for live Student Registration -> Google Sheet sync
# Example: https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: SHA-256 hex digest of your private admin passcode for /admin
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('your-passcode').digest('hex'))"
NEXT_PUBLIC_ADMIN_PASSCODE_HASH=

# Optional: Custom local port
PORT=3000
