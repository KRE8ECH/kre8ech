# KRE8ECH Website Environment Configuration
# Copy this file to .env.local when integrating external database or auth providers

# Optional: Custom port configuration
PORT=3000

# Live Google Sheets / Excel Sync (Google Apps Script Web App URL)
# Deploy google-apps-script/Code.gs as a Web App and paste its /exec URL here
# (and in Cloudflare Pages -> Settings -> Environment variables).
# NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: SHA-256 hex digest of your private admin passcode
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSCODE').digest('hex'))"
# NEXT_PUBLIC_ADMIN_PASSCODE_HASH=

# Optional: NextAuth or external authentication secret (if replacing local admin passcode)
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000

# Optional: Database connection string (e.g., PostgreSQL, Supabase, or MongoDB)
# DATABASE_URL=postgresql://user:password@localhost:5432/kre8ech_db

# Optional: Email Service for Notifications (Resend, SendGrid, SMTP)
# EMAIL_API_KEY=your_email_api_key_here
# FROM_EMAIL=admissions@kre8ech.com
